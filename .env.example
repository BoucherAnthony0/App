# Exemple de configuration d'environnement — copier en `.env` (jamais commité).
# Ce projet ne nécessite aucun secret pour fonctionner ; ces variables sont
# optionnelles et servent à surcharger les chemins par défaut sans toucher au code.

# Chemin du dataset brut (sinon: valeur de config/params.yaml).
# DATA_RAW_PATH=data/raw/male_players.csv

# Chemin du modèle sérialisé servi par l'API et le dashboard.
# MODEL_PATH=models/best_model.joblib

# Hôte/port de l'API FastAPI (uvicorn).
# API_HOST=0.0.0.0
# API_PORT=8000
